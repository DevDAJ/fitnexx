{
  "expo": {
    "name": "Fitnexx",
    "slug": "fitnexx",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitnexx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitnexx.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.fitnexx.app",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fitnexx to access your camera for food scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fitnexx to access your photos for food scanning."
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}
