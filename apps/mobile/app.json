{
  "expo": {
    "name": "Fitnexx",
    "slug": "fitnexx",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitnexx",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitnexx.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.fitnexx.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fitnexx uses your location to detect which gym you are at.",
          "locationAlwaysAndWhenInUsePermission": "Fitnexx uses your location to detect which gym you are at, even while the app is in the background."
        }
      ],
      "expo-task-manager",
      "expo-notifications"
    ]
  }
}
