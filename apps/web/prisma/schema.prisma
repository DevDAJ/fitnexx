generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model InterestListEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String?

  @@index([createdAt])
  @@map("interest_list_entry")
}

model Equipment {
  id       String @id
  name     String @unique
  category String

  @@map("equipment")
}

model Exercise {
  id                  String   @id
  name                String   @unique
  muscleGroupName     String
  requiredEquipmentIds String[]

  @@map("exercise")
}
