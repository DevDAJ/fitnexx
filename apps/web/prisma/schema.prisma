generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model InterestListEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String?

  @@index([createdAt])
  @@map("interest_list_entry")
}

model Equipment {
  id       String @id
  name     String @unique
  category String

  @@map("equipment")
}

model Exercise {
  id                  String   @id
  name                String   @unique
  muscleGroupName     String
  requiredEquipmentIds String[]

  @@map("exercise")
}

model User {
  id        String      @id @default(cuid())
  clerkId   String      @unique
  createdAt DateTime    @default(now())
  scanUsage ScanUsage[]

  @@map("user")
}

model ScanUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  scansUsed  Int      @default(0)
  adsWatched Int      @default(0)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("scan_usage")
}
